# PostgreSQL connection used by Prisma (server-side only; never prefix with NEXT_PUBLIC_)
# Format: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
# Required in Vercel project settings too: `next build` reads content while prerendering,
# so without it the site silently builds with fallback demo content.
# On Vercel prefer the provider's pooled connection string (serverless opens many connections).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/honey_media_house?schema=public"
# 32+ character random secret; generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"
# Canonical public origin (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional story video, e.g. YouTube or Vimeo URL; blank hides trigger
NEXT_PUBLIC_STORY_VIDEO_URL=""
# Optional Vercel Blob persistent object storage for image/resume upload
BLOB_READ_WRITE_TOKEN=""
# Optional email notifications: SMTP provider endpoint/settings (reserved for configuring delivery)
EMAIL_FROM=""
EMAIL_PROVIDER_API_KEY=""
