generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

enum SubmissionStatus {
  NEW
  REVIEWED
  ARCHIVED
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  eyebrow     String?
  body        String?  @db.Text
  content     Json     @default("{}")
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Service {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  description    String        @db.Text
  overview       String        @db.Text
  icon           String        @default("Sparkles")
  image          String
  benefits       Json          @default("[]")
  deliverables   Json          @default("[]")
  process        Json          @default("[]")
  faqs           Json          @default("[]")
  seoTitle       String?
  seoDescription String?       @db.Text
  status         PublishStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([status, sortOrder])
}

model Industry {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  description    String        @db.Text
  overview       String        @db.Text
  image          String
  challenges     Json          @default("[]")
  solutions      Json          @default("[]")
  serviceSlugs   Json          @default("[]")
  seoTitle       String?
  seoDescription String?       @db.Text
  status         PublishStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([status, sortOrder])
}

model ProjectCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  clientLabel    String?
  description    String            @db.Text
  overview       String            @db.Text
  challenge      String            @db.Text
  approach       String            @db.Text
  deliverables   Json              @default("[]")
  gallery        Json              @default("[]")
  results        Json              @default("[]")
  image          String
  demoContent    Boolean           @default(true)
  verifiedResults Boolean          @default(false)
  seoTitle       String?
  seoDescription String?           @db.Text
  status         PublishStatus     @default(DRAFT)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  categories     ProjectCategory[]
  @@index([status, sortOrder])
}

model Testimonial {
  id        String        @id @default(cuid())
  name      String
  role      String
  company   String
  quote     String        @db.Text
  avatar    String?
  demoContent Boolean     @default(true)
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status, sortOrder])
}

model ProcessStep {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([visible, sortOrder])
}

model ArticleCategory {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String    @unique
  articles Article[]
}

model Article {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  excerpt        String          @db.Text
  body           String          @db.Text
  image          String
  categoryId     String
  category       ArticleCategory @relation(fields: [categoryId], references: [id])
  seoTitle       String?
  seoDescription String?         @db.Text
  status         PublishStatus   @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@index([status, publishedAt])
  @@index([categoryId])
}

model JobOpening {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  team           String
  location       String
  employmentType String
  summary        String        @db.Text
  description    String        @db.Text
  requirements   Json          @default("[]")
  seoTitle       String?
  seoDescription String?       @db.Text
  status         PublishStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   JobApplication[]
  @@index([status, sortOrder])
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  service   String?
  message   String        @db.Text
  source    String        @default("contact")
  status    EnquiryStatus @default(NEW)
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status, createdAt])
  @@index([email])
}

model StrategyCallRequest {
  id           String           @id @default(cuid())
  name         String
  email        String
  phone        String
  company      String?
  service      String?
  preferredAt  DateTime
  timezone     String
  message      String?          @db.Text
  status       SubmissionStatus @default(NEW)
  notes        String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@index([status, createdAt])
}

model JobApplication {
  id          String           @id @default(cuid())
  name        String
  email       String
  phone       String
  position    String
  jobId       String?
  job         JobOpening?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resumeUrl   String
  resumeFilename String?
  resumeContentType String?
  resumeData Bytes?
  portfolioUrl String?
  message     String           @db.Text
  status      SubmissionStatus @default(NEW)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@index([status, createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  url          String
  contentType  String
  size         Int
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())
  @@index([isPrivate, createdAt])
}

model LegalPage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  body           String        @db.Text
  seoTitle       String?
  seoDescription String?       @db.Text
  status         PublishStatus @default(PUBLISHED)
  updatedAt      DateTime      @updatedAt
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
  @@index([resetAt])
}
